# Copy to .env and adjust. start.sh / start-staging.sh load this file if present.

# Environment label shown in /api/health
LUZ_ENV=live
# Port for the web app
PORT=8015
# Where the SQLite DB, demo log and WhatsApp session live (staging uses data-staging/)
LUZ_DATA_DIR=data
# Initial admin password (only used the first time the DB is created). Change it in Settings afterwards.
LUZ_ADMIN_PASSWORD=luz-admin
# Random secret for login tokens (optional; auto-generated into data/secret.key when empty)
LUZ_SECRET=
# Port for the WhatsApp Web (Node) bridge; staging should use a different one
WHATSAPP_BRIDGE_PORT=8020
# Set to 1 to skip the WhatsApp Web bridge entirely
LUZ_DISABLE_WHATSAPP_BRIDGE=0
